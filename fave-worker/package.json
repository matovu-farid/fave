{
  "name": "fave-worker",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "db:migrate:local": "wrangler d1 migrations apply fave-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply fave-db --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.5",
    "better-auth": "^1.7.5",
    "hono": "^4.13.9",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "wrangler": "^4.110.0"
  }
}
