{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fave-worker",
  "main": "src/index.ts",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "routes": [
    {
      "pattern": "api.fave.fidexa.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://api.fave.fidexa.org",
    "ENVIRONMENT": "production",
    "WEB_APP_ORIGINS": "http://localhost:8081,http://127.0.0.1:8081"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fave-db",
      "database_id": "99e8531f-eaaa-4de6-a359-0adc1228b3b3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DRIVER_FILES",
      "bucket_name": "fave-private-driver-files"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "queues": {
    "producers": [
      { "binding": "NOTIFICATION_QUEUE", "queue": "fave-notification-delivery" }
    ],
    "consumers": [
      {
        "queue": "fave-notification-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "fave-notification-dlq"
      },
      {
        "queue": "fave-notification-dlq",
        "max_batch_size": 10,
        "max_retries": 1
      }
    ]
  }
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
